# Copy to application-local.properties (auto-loaded, gitignored)
PREPWISE_AI_ENABLED=true

# Use Groq for AI Coach, Interview Planner, and Company Advisor.
LLM_MODE=groq

# Conservative free-tier guardrails. When these are reached, PrepWise uses rule-based fallbacks.
GROQ_ALLOW_AUTO_INSIGHTS=true
AI_TOKEN_BUDGET_PER_MINUTE=4000
AI_REQUEST_BUDGET_PER_MINUTE=4
AI_MAX_OUTPUT_TOKENS=160

GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.1-8b-instant

# Leave Gemini blank when using Groq-only mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-001
